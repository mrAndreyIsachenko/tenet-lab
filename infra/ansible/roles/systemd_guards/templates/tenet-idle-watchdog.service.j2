[Unit]
Description=Tenet v3 GPU Idle Auto-Stop Watchdog
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=15
User={{ tenet_user }}
WorkingDirectory={{ tenet_workdir }}
EnvironmentFile={{ tenet_workdir }}/.env
Environment=NEBIUS_INSTANCE_ID={{ nebius_instance_id | default('', true) }}
ExecStart=/usr/bin/env bash {{ tenet_workdir }}/scripts/remote/idle_watchdog.sh {{ idle_watchdog_minutes }} {{ idle_watchdog_util_pct }}

[Install]
WantedBy=multi-user.target
