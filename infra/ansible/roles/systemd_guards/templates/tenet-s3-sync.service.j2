[Unit]
Description=Tenet v3 Continuous Nebius Object Storage Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ tenet_user }}
WorkingDirectory={{ tenet_workdir }}
EnvironmentFile={{ tenet_workdir }}/.env
Environment=PATH=/home/{{ tenet_user }}/.nebius/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash {{ tenet_workdir }}/scripts/remote/nebius_ctl.sh s3-sync-up
