# Managed by Ansible (infra/ansible/roles/runtime)
UV_NO_SYNC=1
SKIP_UV_SYNC=1
HF_TOKEN={{ lookup('env', 'HF_TOKEN') | default('', true) }}
HF_HOME={{ tenet_workdir }}/hf_cache
MLFLOW_TRACKING_URI={{ mlflow_tracking_uri | default('', true) }}
MLFLOW_TRACKING_USERNAME={{ mlflow_admin_username | default('admin', true) }}
MLFLOW_TRACKING_PASSWORD={{ lookup('env', 'TF_VAR_mlflow_admin_password') | default(lookup('env', 'MLFLOW_TRACKING_PASSWORD'), true) }}
NEBIUS_S3_BUCKET={{ nebius_s3_bucket | default('tenet-v3-artifacts', true) }}
NEBIUS_INSTANCE_ID={{ nebius_instance_id | default('', true) }}
NEBIUS_RESULTS_DIR={{ tenet_workdir }}/results
NEBIUS_REGION={{ nebius_region | default('eu-north1', true) }}
